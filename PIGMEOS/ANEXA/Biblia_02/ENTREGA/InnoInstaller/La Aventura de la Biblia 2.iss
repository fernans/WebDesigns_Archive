; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{95ADF633-BFF9-4DF0-B8BE-F9F6CEBBAC2E}
AppName=La Aventura de la Biblia 2
AppVerName=La Aventura de la Biblia 2
DefaultDirName={pf}\La Aventura de la Biblia 2
DefaultGroupName=La Aventura de la Biblia 2
LicenseFile=..\extr\Terminos_y_condiciones.rtf
OutputBaseFilename=setup
SetupIconFile=..\extr\icono.ico
Compression=lzma
SolidCompression=yes

[Languages]
;Name: "english"; MessagesFile: "compiler:Default.isl"
;Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
;Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\preMaster\principal.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\preMaster\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Code]
function InitializeSetup(): Boolean;
begin
  Result := True;
  if RegKeyExists(HKEY_LOCAL_MACHINE, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{95ADF633-BFF9-4DF0-B8BE-F9F6CEBBAC2E}_is1') then
  begin
    Result := False;
  end
end;

[Icons]
Name: "{group}\La Aventura de la Biblia 2"; Filename: "{app}\principal.exe"
Name: "{group}\{cm:UninstallProgram,La Aventura de la Biblia 2}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\La Aventura de la Biblia 2"; Filename: "{app}\principal.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\principal.exe"; Description: "{cm:LaunchProgram,La Aventura de la Biblia 2}"; Flags: nowait postinstall skipifsilent

