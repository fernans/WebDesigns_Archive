; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{BB353079-ACAC-4442-BFBB-742D63F97FA7}
AppName=L'Avventura della Bibbia
AppVerName=L'Avventura della Bibbia
DefaultDirName={pf}\L'Avventura della Bibbia
DefaultGroupName=L'Avventura della Bibbia
LicenseFile=..\..\preMaster\it\Terminos_y_condiciones.rtf
OutputBaseFilename=setup
SetupIconFile=..\..\extr\icono.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
;Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
;Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\..\preMaster\it\Biblia.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\preMaster\it\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Code]
function InitializeSetup(): Boolean;
begin
  Result := True;
  if RegKeyExists(HKEY_LOCAL_MACHINE, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{BB353079-ACAC-4442-BFBB-742D63F97FA7}_is1') then
  begin
    Result := False;
  end
end;

[Icons]
Name: "{group}\L'Avventura della Bibbia"; Filename: "{app}\Biblia.exe"
Name: "{group}\{cm:UninstallProgram,L'Avventura della Bibbia}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\L'Avventura della Bibbia"; Filename: "{app}\Biblia.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Biblia.exe"; Description: "{cm:LaunchProgram,L'Avventura della Bibbia}"; Flags: nowait postinstall skipifsilent

