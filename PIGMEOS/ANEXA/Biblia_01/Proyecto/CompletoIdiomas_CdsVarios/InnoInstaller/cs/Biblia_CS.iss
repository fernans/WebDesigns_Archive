; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{A4A35326-1918-46CB-8011-C72836B8D0DD}
AppName=La Aventura de la Biblia
AppVerName=La Aventura de la Biblia
DefaultDirName={pf}\La Aventura de la Biblia
DefaultGroupName=La Aventura de la Biblia
LicenseFile=..\..\preMaster\cs\Terminos_y_condiciones.rtf
OutputBaseFilename=setup
SetupIconFile=..\..\extr\icono.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
;Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
;Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\..\preMaster\cs\Biblia.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\preMaster\cs\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Code]
function InitializeSetup(): Boolean;
begin
  Result := True;
  if RegKeyExists(HKEY_LOCAL_MACHINE, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{A4A35326-1918-46CB-8011-C72836B8D0DD}_is1') then
  begin
    Result := False;
  end
end;

[Icons]
Name: "{group}\La Aventura de la Biblia"; Filename: "{app}\Biblia.exe"
Name: "{group}\{cm:UninstallProgram,La Aventura de la Biblia}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\La Aventura de la Biblia"; Filename: "{app}\Biblia.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Biblia.exe"; Description: "{cm:LaunchProgram,La Aventura de la Biblia}"; Flags: nowait postinstall skipifsilent

