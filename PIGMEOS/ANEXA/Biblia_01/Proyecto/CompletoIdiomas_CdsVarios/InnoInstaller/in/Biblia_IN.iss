; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{30D4FCDF-D4A8-4BCE-9380-0B722FFE038D}
AppName=The Holy Bible Adventure
AppVerName=The Holy Bible Adventure
DefaultDirName={pf}\The Holy Bible Adventure
DefaultGroupName=The Holy Bible Adventure
LicenseFile=..\..\preMaster\in\Terminos_y_condiciones.rtf
OutputBaseFilename=setup
SetupIconFile=..\..\extr\icono.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
;Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
;Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
;Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\..\preMaster\in\Biblia.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\preMaster\in\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Code]
function InitializeSetup(): Boolean;
begin
  Result := True;
  if RegKeyExists(HKEY_LOCAL_MACHINE, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{30D4FCDF-D4A8-4BCE-9380-0B722FFE038D}_is1') then
  begin
    Result := False;
  end
end;

[Icons]
Name: "{group}\The Holy Bible Adventure"; Filename: "{app}\Biblia.exe"
Name: "{group}\{cm:UninstallProgram,The Holy Bible Adventure}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\The Holy Bible Adventure"; Filename: "{app}\Biblia.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Biblia.exe"; Description: "{cm:LaunchProgram,The Holy Bible Adventure}"; Flags: nowait postinstall skipifsilent

