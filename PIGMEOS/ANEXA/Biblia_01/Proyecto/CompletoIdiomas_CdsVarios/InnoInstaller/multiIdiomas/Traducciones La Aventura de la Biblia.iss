[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{6EC6A7F2-4179-4884-B2AD-81A2CD9654AB}
AppName=La Aventura de la Biblia
AppVerName=La Aventura de la Biblia
DefaultDirName={pf}\La Aventura de la Biblia
DefaultGroupName=La Aventura de la Biblia
LicenseFile=D:\Biblia1\CompletoIdiomas\preMaster\Terminos_y_condiciones.rtf
OutputBaseFilename=setup
SetupIconFile=D:\Biblia1\CompletoIdiomas\extr\icono.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "D:\Biblia1\CompletoIdiomas\preMaster\Inicio.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\Biblia1\CompletoIdiomas\preMaster\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Code]
function InitializeSetup(): Boolean;
begin
  Result := True;
  if RegKeyExists(HKEY_LOCAL_MACHINE, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{6EC6A7F2-4179-4884-B2AD-81A2CD9654AB}_is1') then
  begin
    Result := False;
  end
end;

[Icons]
Name: "{group}\La Aventura de la Biblia"; Filename: "{app}\Inicio.exe"
Name: "{group}\{cm:UninstallProgram,La Aventura de la Biblia}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\La Aventura de la Biblia"; Filename: "{app}\Inicio.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Inicio.exe"; Description: "{cm:LaunchProgram,La Aventura de la Biblia}"; Flags: nowait postinstall skipifsilent

