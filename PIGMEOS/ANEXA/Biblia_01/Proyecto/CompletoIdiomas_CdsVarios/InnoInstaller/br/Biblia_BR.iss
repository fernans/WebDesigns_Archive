; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{E95C7786-9A29-4F17-B3FC-2A3733CA419E}
AppName=A Aventura da Biblia
AppVerName=A Aventura da Biblia
DefaultDirName={pf}\A Aventura da Biblia
DefaultGroupName=A Aventura da Biblia
LicenseFile=..\..\preMaster\br\Terminos_y_condiciones.rtf
OutputBaseFilename=setup
SetupIconFile=..\..\extr\icono.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
;Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
;Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\..\preMaster\br\Biblia.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\preMaster\br\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Code]
function InitializeSetup(): Boolean;
begin
  Result := True;
  if RegKeyExists(HKEY_LOCAL_MACHINE, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{E95C7786-9A29-4F17-B3FC-2A3733CA419E}_is1') then
  begin
    Result := False;
  end
end;

[Icons]
Name: "{group}\A Aventura da Biblia"; Filename: "{app}\Biblia.exe"
Name: "{group}\{cm:UninstallProgram,A Aventura da Biblia}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\A Aventura da Biblia"; Filename: "{app}\Biblia.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Biblia.exe"; Description: "{cm:LaunchProgram,A Aventura da Biblia}"; Flags: nowait postinstall skipifsilent

